# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# OpenAI Configuration
OPENAI_API_KEY=sk-xxx

# Stripe Configuration (set in Railway dashboard)
# Get keys from: https://dashboard.stripe.com/apikeys
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID_EUR=price_xxx
STRIPE_PRICE_ID_USD=price_xxx

# Subscription enforcement
SUBSCRIPTION_REQUIRED=false

# Comma-separated emails that bypass subscription checks entirely
SUBSCRIPTION_BYPASS_EMAILS=

# Comma-separated emails that can access Stripe features when STRIPE_ENABLED=false
# Useful for testing before global rollout
STRIPE_TEST_USERS=test@example.com

# Admin access
ADMIN_EMAILS=admin@cfo-lens.com

# Frontend URL (used for Stripe redirect URLs)
FRONTEND_URL=https://cfo-lens.com

# Server port (Railway sets this automatically)
PORT=3000
